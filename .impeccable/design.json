  "narrative": {
    "northStar": "A Quiet Writing Desk",
    "overview": "A quiet writing desk: cool white pages, ink typography, a clear blue action, and an airy rhythm. Serif headings make reflection feel personal; native Material controls keep everyday tasks familiar. This is an original synthesis, not a reproduction of supplied artwork.\n\nThe designed dark scheme uses deep ink surfaces and a lighter blue accent. The system expresses its character through semantic Material color roles, bundled fonts, and restrained component spacing. Kotlin/Compose source is the visual authority; this document records the implemented theme and shared components.",
    "keyCharacteristics": [
      "White/blue identity with a designed dark scheme.",
      "Editorial headlines paired with legible sans-serif controls.",
      "Native Material 3 interactions and accessible touch targets.",
      "Honest empty and recovery states without fabricated journal history."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Read colors from MaterialTheme.colorScheme so light and dark roles travel together; do not hardcode a light color into a component.",
        "section": "colors"
      },
      {
        "name": "The Editorial Hierarchy Rule",
        "body": "Use DM Serif Display for headline roles and Plus Jakarta Sans for titles, body, and controls; preserve Android font scaling.",
        "section": "typography"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Use the Material surface hierarchy and standard component elevation; do not introduce arbitrary decorative shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the bundled fonts, Material icons, and existing eight-ray Aster mark.",
      "Do keep interactive targets at least 48dp, provide meaningful Compose semantics, and express state beyond color.",
      "Do preserve Indonesian copy, system Back, source collection, Android insets, text selection, and standard ripple feedback.",
      "Do inspect actual Android empty, populated, editor, and recovery states in both themes, compact and expanded layouts, with the IME and 1.3–2.0 font scale."
    ],
    "donts": [
      "Don't add reference screenshots to the APK or make decorative photos a dependency.",
      "Don't invent sample personal entries or imply cloud sync, encryption, biometric protection, AI processing, or clinical benefits.",
      "Don't treat browser mockups as native visual verification or emulator results as physical POCO F6 performance evidence.",
      "Don't let decoration, animation, or premature saved feedback outrank legibility and persisted writing."
    ]
